# Example Terraform variables file
# Copy this file to terraform.tfvars and update the values

aws_region   = "us-east-1"
environment  = "production"
domain_name  = "medisupply.com"
project_name = "medisupply"

tags = {
  Project     = "MediSupply"
  Environment = "production"
  ManagedBy   = "Terraform"
  Team        = "Grupo1A"
}
