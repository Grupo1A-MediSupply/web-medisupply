  "services": {
    "auth": {
      "description": "Servicio de autenticación y gestión de usuarios",
      "endpoints": {
        "POST /auth/signup": {
          "request": {
            "email": "string (required)",
            "password": "string (required, min 6 chars)",
            "role": "string (required, 'vendor' | 'client')",
            "name": "string (required)",
            "phone": "string (optional)",
            "address": "string (optional)",
            "institutionName": "string (optional, para clientes)"
          },
          "successResponse": {
            "statusCode": 201,
            "body": {
              "message": "Usuario registrado exitosamente",
              "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
              "user": {
                "id": "507f1f77bcf86cd799439011",
                "email": "vendor@example.com",
                "role": "vendor",
                "name": "Juan Pérez"
              }
            }
          },
          "errorResponse": {
            "statusCode": 400,
            "body": {
              "error": "El email ya está registrado",
              "message": "Ya existe un usuario con este email"
            }
          }
        },
        "POST /auth/login": {
          "request": {
            "email": "string (required)",
            "password": "string (required)"
          },
          "successResponseWithMFA": {
            "statusCode": 200,
            "body": {
              "message": "Código MFA enviado",
              "mfaRequired": true,
              "userId": "507f1f77bcf86cd799439011",
              "mfaCode": "123456"
            },
            "note": "mfaCode solo en desarrollo, no en producción"
          },
          "successResponseWithoutMFA": {
            "statusCode": 200,
            "body": {
              "message": "Login exitoso",
              "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
              "user": {
                "id": "507f1f77bcf86cd799439011",
                "email": "vendor@example.com",
                "role": "vendor",
                "name": "Juan Pérez"
              },
              "mfaRequired": false
            }
          },
          "errorResponse": {
            "statusCode": 401,
            "body": {
              "error": "Credenciales inválidas",
              "message": "Email o contraseña incorrectos"
            }
          }
        },
        "POST /auth/mfa/verify": {
          "request": {
            "userId": "string (required)",
            "code": "string (required, 6 dígitos)"
          },
          "successResponse": {
            "statusCode": 200,
            "body": {
              "message": "MFA verificado exitosamente",
              "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
              "user": {
                "id": "507f1f77bcf86cd799439011",
                "email": "vendor@example.com",
                "role": "vendor",
                "name": "Juan Pérez"
              }
            }
          },
          "errorResponse": {
            "statusCode": 400,
            "body": {
              "error": "Código MFA inválido",
              "message": "El código ingresado es incorrecto o ha expirado"
            }
          }
        },
        "POST /auth/change-password": {
          "request": {
            "currentPassword": "string (required)",
            "newPassword": "string (required, min 6 chars)"
          },
          "successResponse": {
            "statusCode": 200,
            "body": {
              "message": "Contraseña cambiada exitosamente"
            }
          },
          "errorResponse": {
            "statusCode": 400,
            "body": {
              "error": "Contraseña actual incorrecta",
              "message": "La contraseña actual no es válida"
            }
          }
        },
        "GET /auth/profile": {
          "successResponse": {
            "statusCode": 200,
            "body": {
              "user": {
                "id": "507f1f77bcf86cd799439011",
                "email": "vendor@example.com",
                "role": "vendor",
                "name": "Juan Pérez",
                "phone": "+57 300 123 4567",
                "address": "Calle 10 #20-30, Bogotá",
                "institutionName": null
              }
            }
          }
        }
      }
    },
